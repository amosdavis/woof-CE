#!/bin/sh
# /etc/rc.d/rc.firewall - Default Puppy Linux Firewall
# Provides a secure default deny-inbound policy using iptables
# This addresses: no-firewall-by-default, SYN flood protection,
# network intrusion logging, IP forwarding attacks, ICMP attacks
#
# To customize, edit /etc/rc.d/firewall.conf or use the firewall_ng GUI

CONF="/etc/rc.d/firewall.conf"

# Load user configuration if exists
[ -f "$CONF" ] && . "$CONF"

# Default values
ALLOW_PING=${ALLOW_PING:-yes}
LOG_DROPPED=${LOG_DROPPED:-yes}
ALLOW_SSH=${ALLOW_SSH:-no}
ALLOWED_TCP_IN=${ALLOWED_TCP_IN:-}
ALLOWED_UDP_IN=${ALLOWED_UDP_IN:-}
ENABLE_IPV6=${ENABLE_IPV6:-yes}

start() {
    echo -n "Starting firewall..."

    # Determine iptables command
    IPT=$(command -v iptables 2>/dev/null)
    [ -z "$IPT" ] && IPT=$(command -v iptables-legacy 2>/dev/null)
    if [ -z "$IPT" ]; then
        echo "iptables not found, firewall not started"
        return 1
    fi

    IP6T=$(command -v ip6tables 2>/dev/null)
    [ -z "$IP6T" ] && IP6T=$(command -v ip6tables-legacy 2>/dev/null)

    #--- IPv4 Rules ---

    # Flush existing rules
    $IPT -F
    $IPT -X
    $IPT -t nat -F
    $IPT -t nat -X
    $IPT -t mangle -F
    $IPT -t mangle -X

    # Set default policies: deny inbound, allow outbound
    $IPT -P INPUT DROP
    $IPT -P FORWARD DROP
    $IPT -P OUTPUT ACCEPT

    # Allow loopback
    $IPT -A INPUT -i lo -j ACCEPT
    $IPT -A OUTPUT -o lo -j ACCEPT

    # Allow established and related connections
    $IPT -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

    # Drop invalid packets
    $IPT -A INPUT -m conntrack --ctstate INVALID -j DROP

    # SYN flood protection
    $IPT -A INPUT -p tcp --syn -m limit --limit 1/s --limit-burst 4 -j ACCEPT

    # Drop fragmented packets
    $IPT -A INPUT -f -j DROP

    # Drop XMAS packets
    $IPT -A INPUT -p tcp --tcp-flags ALL ALL -j DROP

    # Drop NULL packets
    $IPT -A INPUT -p tcp --tcp-flags ALL NONE -j DROP

    # Rate-limit ICMP (ping)
    if [ "$ALLOW_PING" = "yes" ]; then
        $IPT -A INPUT -p icmp --icmp-type echo-request -m limit --limit 1/s --limit-burst 4 -j ACCEPT
    else
        $IPT -A INPUT -p icmp --icmp-type echo-request -j DROP
    fi

    # Allow necessary ICMP types
    $IPT -A INPUT -p icmp --icmp-type destination-unreachable -j ACCEPT
    $IPT -A INPUT -p icmp --icmp-type time-exceeded -j ACCEPT

    # Allow SSH if enabled
    if [ "$ALLOW_SSH" = "yes" ]; then
        $IPT -A INPUT -p tcp --dport 22 -m conntrack --ctstate NEW -m limit --limit 3/min --limit-burst 3 -j ACCEPT
    fi

    # Allow custom TCP ports
    for port in $ALLOWED_TCP_IN; do
        $IPT -A INPUT -p tcp --dport $port -m conntrack --ctstate NEW -j ACCEPT
    done

    # Allow custom UDP ports
    for port in $ALLOWED_UDP_IN; do
        $IPT -A INPUT -p udp --dport $port -j ACCEPT
    done

    # Allow DHCP client
    $IPT -A INPUT -p udp --sport 67 --dport 68 -j ACCEPT

    # Allow mDNS (local network discovery)
    $IPT -A INPUT -p udp --dport 5353 -d 224.0.0.251 -j ACCEPT

    # Log dropped packets (rate limited)
    if [ "$LOG_DROPPED" = "yes" ]; then
        $IPT -A INPUT -m limit --limit 5/min -j LOG --log-prefix "FW_DROP: " --log-level 4
    fi

    # Final drop (implicit via policy, but explicit for clarity)
    $IPT -A INPUT -j DROP
    $IPT -A FORWARD -j DROP

    #--- IPv6 Rules ---
    if [ -n "$IP6T" ] && [ "$ENABLE_IPV6" = "yes" ]; then
        $IP6T -F
        $IP6T -X
        $IP6T -P INPUT DROP
        $IP6T -P FORWARD DROP
        $IP6T -P OUTPUT ACCEPT

        $IP6T -A INPUT -i lo -j ACCEPT
        $IP6T -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
        $IP6T -A INPUT -m conntrack --ctstate INVALID -j DROP

        # Allow ICMPv6 (required for IPv6 to function)
        $IP6T -A INPUT -p ipv6-icmp -j ACCEPT

        # Allow DHCPv6
        $IP6T -A INPUT -p udp --dport 546 -j ACCEPT

        # Allow link-local
        $IP6T -A INPUT -s fe80::/10 -j ACCEPT

        # Log and drop
        if [ "$LOG_DROPPED" = "yes" ]; then
            $IP6T -A INPUT -m limit --limit 5/min -j LOG --log-prefix "FW6_DROP: " --log-level 4
        fi

        $IP6T -A INPUT -j DROP
        $IP6T -A FORWARD -j DROP
    elif [ -n "$IP6T" ]; then
        # If IPv6 disabled, drop everything
        $IP6T -P INPUT DROP
        $IP6T -P FORWARD DROP
        $IP6T -P OUTPUT DROP
    fi

    echo " done"
    return 0
}

stop() {
    echo -n "Stopping firewall..."

    IPT=$(command -v iptables 2>/dev/null)
    [ -z "$IPT" ] && IPT=$(command -v iptables-legacy 2>/dev/null)
    IP6T=$(command -v ip6tables 2>/dev/null)
    [ -z "$IP6T" ] && IP6T=$(command -v ip6tables-legacy 2>/dev/null)

    if [ -n "$IPT" ]; then
        $IPT -F
        $IPT -X
        $IPT -t nat -F
        $IPT -t nat -X
        $IPT -t mangle -F
        $IPT -t mangle -X
        $IPT -P INPUT ACCEPT
        $IPT -P FORWARD ACCEPT
        $IPT -P OUTPUT ACCEPT
    fi

    if [ -n "$IP6T" ]; then
        $IP6T -F
        $IP6T -X
        $IP6T -P INPUT ACCEPT
        $IP6T -P FORWARD ACCEPT
        $IP6T -P OUTPUT ACCEPT
    fi

    echo " done"
    return 0
}

status() {
    IPT=$(command -v iptables 2>/dev/null)
    [ -z "$IPT" ] && IPT=$(command -v iptables-legacy 2>/dev/null)
    if [ -z "$IPT" ]; then
        echo "iptables not found"
        return 1
    fi
    RULES=$($IPT -L -n 2>/dev/null | wc -l)
    if [ "$RULES" -gt 10 ]; then
        echo "Firewall is ACTIVE ($RULES rules loaded)"
        return 0
    else
        echo "Firewall is INACTIVE"
        return 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
